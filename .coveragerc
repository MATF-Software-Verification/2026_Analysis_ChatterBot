# podesavanja za coverage.py
[run]
# merim analizirani projekat
source = ChatterBot/chatterbot

omit =
    # tudji testovi
    */ChatterBot/tests/*
    # tabela podataka bez logike koju sam import pokrije
    */languages.py
    # van obima rada
    */storage/redis.py
    */storage/mongodb.py
    */vectorstores.py
    */ext/django_chatterbot/*
